# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env git'e girmez.
# docker compose POSTGRES_* değişkenlerini, uygulama diğerlerini okur.

POSTGRES_USER=andon
POSTGRES_PASSWORD=andon
POSTGRES_DB=andon
POSTGRES_PORT=5432

DATABASE_URL=postgresql://andon:andon@127.0.0.1:5432/andon

# Giriş (JWT). Boş bırakılırsa her açılışta rastgele anahtar üretilir ve oturumlar düşer.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_GIZLI_ANAHTAR=

# seed.py'nin oluşturduğu demo kullanıcılarının (operator, bakim) parolası
DEMO_PAROLA=andon-demo

# LLM sağlayıcısı: gemini (varsayılan) ya da ollama
LLM_SAGLAYICI=gemini

# Google AI Studio'dan alınan anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: varsayılan model (gemini-3.5-flash-lite) yerine başka bir model, örn. gemini-3.8-flash
# LLM_MODEL=

# Ollama kullanılacaksa (LLM_SAGLAYICI=ollama). Varsayılan model: qwen3:4b
# OLLAMA_URL=http://localhost:11434/v1
