# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env git'e girmez.
# docker compose POSTGRES_* değişkenlerini, uygulama diğerlerini okur.

POSTGRES_USER=andon
POSTGRES_PASSWORD=andon
POSTGRES_DB=andon
POSTGRES_PORT=5432

DATABASE_URL=postgresql://andon:andon@localhost:5432/andon

# LLM sağlayıcısı: gemini (varsayılan) ya da ollama
LLM_SAGLAYICI=gemini

# Google AI Studio'dan alınan anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: varsayılan model yerine başka bir model (gemini-3.8-flash, gemini-3.5-flash-lite ...)
# LLM_MODEL=

# Ollama kullanılacaksa (LLM_SAGLAYICI=ollama). Varsayılan model: qwen3:4b
# OLLAMA_URL=http://localhost:11434/v1
